*******************************************************************************
* MATHAMATICAL MODELS                                                         *
* With thanks to Norman Koren, Charles Rydel, Marshal Leach, Stefano Perugini *
* Scott Rydel, Mike Holmes, LTspice and sage advice from Derk Reefman et al   *
*******************************************************************************
*
*
******************
* Copyright © Linear Technology Corp. 1998, 1999, 2000, 2001, 2002, 2003.  All rights reserved.
* Used for voltage regulators based on gas tubes and neons
*
.subckt VRTUBE 1 2
S1 1 2 2 N001 G
S2 2 1 N001 2 G
R1 1 N001 100Meg
C1 N001 2 {Tau/100Meg}
.model G SW(Ron={Zon} Roff=1T Vt={.5*(Vstrike+Vhold)} Vh={.5*(Vstrike-Vhold)} Vser={Vhold-Ihold*Zon})
.ends VRTUBE

******************
* (Diode - Stefano Perugini's Second improvement)
* Ip= (Ka+Kb*Vplate)*POW((Vplate+EPS),EX)
*             anode
*             | cathode
*             | |
.SUBCKT RECP2 1 2
RE	7	0	1MEG    ; DUMMY SO NODE 7 HAS 2 CONNECTIONS
E1	7	0	VALUE=({Ka}+{Kb}*V(1,2))* POW(V(1,2)+{EPS},{EX})
G1	1	2	VALUE=if(V(1,2)+{EPS}>0, V(7), 0)
R1	1	2	1T
.ENDS	RECP2

******************
* (Diode - Stefano Perugini's Second improvement)
* Ip = (Ka+Kb*Vplate)*POW((Vplate+EPS),EX)
*                 anode 1
*                 | anode 2
*                 | | cathode
*                 | | |
.SUBCKT DULERECP2 1 2 3
X1	1	3	RECP2 ;
X2	2	3	RECP2 ;
.ENDS DULERECP2

******************
.SUBCKT TRIODE 1 2 3 ; A G C
* Norman Koren's original Triode formula
E1  7 0 VALUE={V(1,3)/KP*LOG(1+EXP(KP*(1/MU+(V(2,3)+VCT)/SQRT(KVB+V(1,3)*V(1,3)))))}
Ga  1 3 VALUE={(PWR(V(7,0),EX)+PWRS(V(7,0),EX))/KG1}							; Anode Current
* Taken from Rydel's Pentode model
Gg1		2   3	VALUE={IF(V(2,3)>0,ALPHA*PWR(V(2,3),1.5),BETA/-(V(2,3)-.1))}	; Control Grid is a thermionic diode FFS
* inter electrode capacitence
C1		2	3	{CCG}															; CATHODE-GRID
C2		2	1	{CGP}															; GRID=PLATE
C3		1	3	{CCP}															; CATHODE-PLATE
* Dummy resistors so nodes have 2 connections
RE1		7	0	1G																; DUMMY SO NODE 7 HAS 2 CONNECTIONS
RCP		1	3	1G      														; FOR CONVERGENCE             A  - C
RF2		2	3	50MEG
.ENDS	TRIODE
*
******************
* Pentodes with Supressor Grid control
* I do not know what possessed LTspice to do the Pentode symbol this way. Consistency what is that? But It is what it is.
.SUBCKT PENTODE 1 2 3 4 5 ; C G1 G2 G3 A
* Norman Koren's original formula
E1		7	0	VALUE={V(3,1)/KP*LOG(1+EXP((1/MU+(V(2,1))/V(3,1))*KP))}			; E1 BREAKS UP LONG EQUATION FOR Ga and Gc.
E2		8	0	VALUE={(PWR(V(7),EX)+PWRS(V(7),EX))}							; E2 saves Calculation twice for Ga and Gc.
* Mike Holms Suppressor grid formula - modified to accomidate Space charge mods
E3b   dar   0   VALUE={if( V(4,1)>0, 1+V(4,1)*0.13, 1/((1+abs(V(4,1))*0.1)**1.5))}	; delta ar
*               ^ if Vg3 to k > 0, use the first calc., else use the second.
* The above are merely ratios by which the final anode and screen currents are multiplied to either increase or decrease by 1+ some fraction, as appropriate.
E3a     9   0   VALUE={IF( V(dar) >1.1, 1.1, V(dar))}							; approximate to a scurve
*
* For the modified Koren model we do not need to effect the screen current because of the way that screen current is calculated Cathode Current - Anode current
*
* Norman Koren original formula V1 Modified with Mike Holms G3 Mod
Ga		5	3	VALUE={(V(8)*(1/KG1)*(ATAN(V(5,1)/KVB)))*V(9)}					; Anode Current
* A nod to Marshall Leach's ideas and Space Charge
Gc		3	1	VALUE={(V(8)/KG2)}												; Cathode Current
* Taken from Rydel's Tube models
Gg1		2   1	VALUE={IF(V(2,1)>0,ALPHA*PWR(V(2,1),1.5),BETA/-(V(2,1)-.1))}	; Control Grid is a thermionic diode FFS
Gg3		4   1	VALUE={IF(V(4,1)>0,ALPHA*PWR(V(4,1),1.5),BETA/-(V(4,1)-.1))}	; Suppressor Grid is a thermionic diode FFS
* inter electrode capacitance
C1		1	2	{CCG}   														; CATHODE-GRID 1              C  - G1
C2		2	5	{CPG1}															; GRID 1-PLATE                G1 - A
C3		1	5	{CCP}   														; CATHODE-PLATE               A  - C
C4		1	4	{CCG3}   														; CATHODE-GRID 3              C  - G3   														; CATHODE-GRID 1              C  - G1
C5		4	5	{CPG3}															; GRID 3-PLATE                G3 - A
* Dummy resistors so nodes have 2 connections
RE1		7	0	1G																; DUMMY SO NODE 7 HAS 2 CONNECTIONS
RE2		8	0	1G																; DUMMY SO NODE 8 HAS 2 CONNECTIONS
RE3		9	0	1G																; DUMMY SO NODE 9 HAS 2 CONNECTIONS
RCP		1	4	1G      														; FOR CONVERGENCE             A  - C
RF1		1	2	50MEG															; Control Grid leak
RF2		1	4	50MEG															; Suppressor Grid leak
.ENDS PENTODE
*
******************
.SUBCKT PENTODE1 1 2 3 4 ; A G2 G1 C
* Norman Koren's original formula
E1		7	0	VALUE={V(2,4)/KP*LOG(1+EXP((1/MU+V(3,4)/V(2,4))*KP))}			; E1 BREAKS UP LONG EQUATION FOR Ga and Gc.
E2		8	0	VALUE={(PWR(V(7),EX)+PWRS(V(7),EX))}							; E2 saves Calculation twice for Ga and Gc.
* Norman Koren original formula V1
Ga		1	2	VALUE={V(8)/KG1*ATAN(V(1,4)/KVB)}								; Anode Current
* A nod to Marshall Leach's ideas about Space Charge
Gc		2	4	VALUE={V(8)/KG2}												; Cathode Current
* Taken from Rydel's Pentode model
Gg1		3   4	VALUE={IF(V(3,4)>0,ALPHA*PWR(V(3,4),1.5),BETA/-(V(3,4)-.1))}	; Control Grid is a thermionic diode FFS
* inter electrode capacitence
C1		3	4	{CCG}   														; CATHODE-GRID 1              C  - G1
C2		1	3	{CPG1}															; GRID 1-PLATE                G1 - A
C3		1	4	{CCP}   														; CATHODE-PLATE               A  - C
* Dummy resistors so nodes have 2 connections
RE1		7	0	1G																; DUMMY SO NODE 7 HAS 2 CONNECTIONS
RE2		8	0	1G																; DUMMY SO NODE 8 HAS 2 CONNECTIONS
RCP		1	4	1G      														; FOR CONVERGENCE             A  - C
RF2		3	4	50MEG
.ENDS PENTODE1
*
******************
.SUBCKT PENTODE2 1 2 3 4 ; A G2 G1 C
* Norman Koren's original formula
E1		7	0	VALUE={V(2,4)/KP*LOG(1+EXP((1/MU+V(3,4)/V(2,4))*KP))}			; E1 BREAKS UP LONG EQUATION FOR Ga and Gc.
E2		8	0	VALUE={(PWR(V(7),EX)+PWRS(V(7),EX))}							; E2 saves Calculation twice for Ga and Gc.
* Norman Koren original formula V2
Ga		1	2	VALUE={pi/2*V(8)/KG1*(1-exp(-2*V(1,4)/(pi*KVB)))}				; Anode Current
* A nod to Marshall Leach's ideas about Space Charge
Gc		2	4	VALUE={V(8)/KG2}												; Cathode Current
* Taken from Rydel's Pentode model
Gg1		3   4	VALUE={IF(V(3,4)>0,ALPHA*PWR(V(3,4),1.5),BETA/-(V(3,4)-.1))}	; Control Grid is a thermionic diode FFS
* inter electrode capacitence
C1		3	4	{CCG}   														; CATHODE-GRID 1              C  - G1
C2		1	3	{CPG1}															; GRID 1-PLATE                G1 - A
C3		1	4	{CCP}   														; CATHODE-PLATE               A  - C
* Dummy resistors so nodes have 2 connections
RE1		7	0	1G																; DUMMY SO NODE 7 HAS 2 CONNECTIONS
RE2		8	0	1G																; DUMMY SO NODE 8 HAS 2 CONNECTIONS
RCP		1	4	1G      														; FOR CONVERGENCE             A  - C
RF2		3	4	50MEG
.ENDS PENTODE2
*
******************
.SUBCKT PENTODE3 1 2 3 4 ; A G2 G1 C
* Norman Koren's original formula
E1		7	0	VALUE={V(2,4)/KP*LOG(1+EXP((1/MU+V(3,4)/V(2,4))*KP))}			; E1 BREAKS UP LONG EQUATION FOR Ga and Gc.
E2		8	0	VALUE={(PWR(V(7),EX)+PWRS(V(7),EX))}							; E2 saves Calculation twice for Ga and Gc.
* Norman Koren original Anode formula V3
Ga		1	2	VALUE={pi/2*V(8)/KG1*tanh(2*V(1,4)/(pi*KVB))}					; Anode Current
* A nod to Marshall Leach's ideas about Space Charge
Gc		2	4	VALUE={V(8)/KG2}												; Cathode Current
* Taken from Rydel's Pentode model
Gg1		3   4	VALUE={IF(V(3,4)>0,ALPHA*PWR(V(3,4),1.5),BETA/-(V(3,4)-.1))}	; Control Grid is a thermionic diode FFS
* inter electrode capacitence
C1		3	4	{CCG}   														; CATHODE-GRID 1              C  - G1
C2		1	3	{CPG1}															; GRID 1-PLATE                G1 - A
C3		1	4	{CCP}   														; CATHODE-PLATE               A  - C
* Dummy resistors so nodes have 2 connections
RE1		7	0	1G																; DUMMY SO NODE 7 HAS 2 CONNECTIONS
RE2		8	0	1G																; DUMMY SO NODE 8 HAS 2 CONNECTIONS
RCP		1	4	1G      														; FOR CONVERGENCE             A  - C
RF2		3	4	50MEG
.ENDS PENTODE3
*
******************
.SUBCKT HEXODE  1 2 3 4 5 ; A G4+G2 G1 C G3
* Norman Koren's original formula
* modified by Suusi M-B to allow a second control grid
E1		7	0	VALUE={V(2,4)/KP*LOG(1+EXP((1/MU+(V(3,4)+V(5,4))/V(2,4))*KP))}	; E1 BREAKS UP LONG EQUATION FOR Ga and Gc.
E2		8	0	VALUE={(PWR(V(7),EX)+PWRS(V(7),EX))}							; E2 saves Calculation twice for Ga and Gc.
Ga		1	2	VALUE={V(8)/KG1*ATAN(V(1,4)/KVB)}								; Anode Current
* A nod to Marshall Leach's ideas about Space Charge
Gc		2	4	VALUE={V(8)/KG2}												; Cathode Current
* Taken from Rydel's Pentode model
Gg1		3   4	VALUE={IF(V(3,4)>0,ALPHA*PWR(V(3,4),1.5),BETA/-(V(3,4)-.1))}	; Control Grid1 is a thermionic diode FFS
Gg3		5   4	VALUE={IF(V(5,4)>0,ALPHA*PWR(V(5,4),1.5),BETA/-(V(5,4)-.1))}	; Control Grid3 is a thermionic diode FFS
* inter electrode capacitence
C1		3	4	{CCG1}															; CATHODE-GRID 1              C  - G1
C2		5	4	{CCG2}															; CATHODE-GRID 2              C  - G3
C3		1	3	{CPG1}															; GRID 1-PLATE                G1 - A
C4		1	5	{CPG2}															; GRID 2-PLATE                G3 - A
C5		1	4	{CCP}															; CATHODE-PLATE               A  - C
* Dummy resistors so nodes have 2 connections
RE1		7	0	1G																; DUMMY SO NODE 7 HAS 2 CONNECTIONS
RE2		8	0	1G																; DUMMY SO NODE 8 HAS 2 CONNECTIONS
RCP		1	4	1G      														; FOR CONVERGENCE             A  - C
RF2		3	4	50MEG
.ENDS HEXODE
